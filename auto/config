#!/bin/sh
# EliteLinux 1.0: live-образ на Debian 13 «trixie» с установщиком Calamares
# и загрузочным меню GRUB (BIOS и UEFI).
set -e

lb config noauto \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-archive-areas "main contrib non-free non-free-firmware" \
  --security true \
  --updates true \
  --apt-recommends false \
  --debootstrap-options "--include=ca-certificates" \
  --binary-images iso-hybrid \
  --debian-installer none \
  --bootloaders "grub-pc grub-efi" \
  --iso-application "EliteLinux" \
  --iso-publisher "Elitny Sochi" \
  --iso-volume "EliteLinux 1.0" \
  --image-name "elitelinux-1.0" \
  --bootappend-live "boot=live components quiet splash locales=ru_RU.UTF-8 keyboard-layouts=us,ru keyboard-options=grp:alt_shift_toggle timezone=Europe/Moscow" \
  "${@}"
