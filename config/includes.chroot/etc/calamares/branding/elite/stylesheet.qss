/* EliteLinux: графит + золото */
QWidget { font-family: "Inter"; font-size: 11pt; color: #ececec; background-color: #232325; }
QPushButton { background-color: #313134; border: 1px solid #3d3d41; border-radius: 6px; padding: 7px 18px; }
QPushButton:hover { background-color: #3d3d41; }
QPushButton:default, #view-button-next, #view-button-install { background-color: #d4b06a; color: #1a1405; border: none; font-weight: 600; }
QPushButton:disabled { color: #6b6b71; }
QComboBox, QListView, QTreeView, QTableView { background-color: #1c1c1e; border: 1px solid #3d3d41; border-radius: 6px; padding: 4px; }
QListView::item:selected, QTreeView::item:selected { background-color: #d4b06a; color: #1a1405; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked { background-color: #d4b06a; border-radius: 6px; }
QProgressBar { background-color: #1c1c1e; border: none; border-radius: 4px; height: 8px; text-align: center; }
QProgressBar::chunk { background-color: #d4b06a; border-radius: 4px; }
#sidebarApp { background-color: #161618; }
/* логотип в боковой панели — без фона окна (иначе светлый квадрат на тёмной панели) */
#logoApp { background-color: transparent; }
