[Unit]
Description=EliteLinux: GoPro как веб-камера (%i)
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device NetworkManager.service
# не больше трёх попыток подряд — иначе уведомление об ошибке повторялось бы каждые 3 с
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
ExecStart=/usr/lib/elite/elite-gopro-webcam %i
Restart=on-failure
RestartSec=3
