#!/bin/sh
# EliteLinux: только для live-флешки (live-config запускает это при загрузке live-системы).
# Мастер первого запуска EliteSIP не должен открываться поверх установщика —
# в установленной системе автозапуск EliteSIP остаётся.
rm -f /etc/xdg/autostart/elitesip.desktop
# пароль AnyDesk нужен только устанавливаемой системе — в live-сессии убираем
rm -f /etc/elite/anydesk-password
# блокировка экрана: на флешке пароль пользователя никто не знает, а установка идёт
# 10 минут — экран блокировался прямо поверх установщика
rm -f /etc/xdg/autostart/light-locker.desktop
# и без гашения экрана (X DPMS): иначе к концу установки экран чёрный
cat > /etc/xdg/autostart/elite-live-noblank.desktop <<'EOD'
[Desktop Entry]
Type=Application
Name=EliteLinux: не гасить экран на флешке
Exec=xset s off -dpms
NoDisplay=true
EOD
