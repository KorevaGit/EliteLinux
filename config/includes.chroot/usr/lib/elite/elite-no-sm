#!/bin/sh
# EliteLinux: запуск программы без подключения к менеджеру сеансов Xfce (XSMP).
# EliteRec и EliteSIP (Avalonia) регистрируются в менеджере сеансов, но не отвечают на
# «сохраните состояние» при выходе — xfce4-session застревал в сохранении сеанса, и
# выход и выключение переставали работать («Менеджер сеансов должен быть в режиме
# ожидания…»). Без SESSION_MANAGER Avalonia к нему не подключается.
unset SESSION_MANAGER
exec "$@"
