#!/bin/sh
# EliteLinux: разово при первой загрузке установленной системы задаёт пароль
# неконтролируемого доступа AnyDesk. Пароль задаётся только при запущенной службе
# AnyDesk, поэтому в установщике его не задать. Автозапуск AnyDesk выключен —
# службу поднимаем на время и снова останавливаем; файл с паролем удаляется.
set -eu
F=/etc/elite/anydesk-password
[ -s "$F" ] || exit 0

systemctl start anydesk.service
i=0
until anydesk --get-id >/dev/null 2>&1 || [ "$i" -ge 30 ]; do sleep 1; i=$((i + 1)); done
tr -d '\n' < "$F" | anydesk --set-password
systemctl stop anydesk.service

rm -f "$F"
systemctl disable elite-anydesk-password.service
