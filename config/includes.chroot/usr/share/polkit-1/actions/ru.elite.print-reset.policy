<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- EliteLinux: сброс очереди печати — любому пользователю за компьютером, без пароля -->
<policyconfig>
  <action id="ru.elite.print-reset">
    <description>Сбросить очередь печати</description>
    <message>Сброс очереди печати</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/elite/elite-print-reset</annotate>
  </action>
</policyconfig>
