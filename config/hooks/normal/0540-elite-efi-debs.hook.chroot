#!/bin/sh
# EliteLinux: пакеты загрузчика UEFI внутри образа — установка без интернета.
# В образе стоит grub-pc (BIOS); grub-efi с ним конфликтует, поэтому ставить его в образ
# нельзя — кладём .deb (с зависимостями и подписанными для Secure Boot) в
# /usr/share/elite/efi-debs, а установщик ставит их на UEFI-машинах (elite-bootloader-config).
set -e
# отдельный пустой кэш: в общем /var/cache/apt/archives лежат все пакеты образа
D=/usr/share/elite/efi-debs
mkdir -p "$D/partial"
apt-get -y --download-only -o Dir::Cache::archives="$D" \
    install grub-efi-amd64 grub-efi-amd64-signed shim-signed efibootmgr mokutil
rm -rf "$D/partial" "$D/lock"
ls "$D" | grep -q '^grub-efi-amd64_'
# только загрузчик и его зависимости, а не весь кэш apt
[ "$(ls "$D"/*.deb | wc -l)" -lt 40 ]
