#!/bin/sh
# EliteLinux: пакеты загрузчика UEFI внутри образа — установка без интернета.
# В образе стоит grub-pc (BIOS); grub-efi с ним конфликтует, поэтому ставить его в образ
# нельзя — кладём .deb (с зависимостями и подписанными для Secure Boot) в
# /usr/share/elite/efi-debs, а установщик ставит их на UEFI-машинах (elite-bootloader-config).
set -e
apt-get -y --download-only install grub-efi-amd64 grub-efi-amd64-signed shim-signed efibootmgr mokutil
mkdir -p /usr/share/elite/efi-debs
cp /var/cache/apt/archives/*.deb /usr/share/elite/efi-debs/
apt-get clean
ls /usr/share/elite/efi-debs | grep -q '^grub-efi-amd64_'
