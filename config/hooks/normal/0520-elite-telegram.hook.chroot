#!/bin/sh
# EliteLinux: официальная сборка Telegram Desktop в /opt/telegram.
set -e

apt-get install -y --no-install-recommends curl xz-utils ca-certificates
tmp="$(mktemp -d)"
curl -fsSL --retry 3 -o "$tmp/tg.tar.xz" https://telegram.org/dl/desktop/linux
# --no-same-owner: в архиве владелец UID 1000 — без ключа /opt/telegram достался бы «Менеджеру»
tar --no-same-owner -xJf "$tmp/tg.tar.xz" -C "$tmp"
rm -rf /opt/telegram
mv "$tmp/Telegram" /opt/telegram
rm -rf "$tmp"
# Пользователи без sudo: группа users может писать в /opt/telegram, чтобы
# работало встроенное автообновление Telegram.
chown -R root:users /opt/telegram
chmod -R g+w /opt/telegram
