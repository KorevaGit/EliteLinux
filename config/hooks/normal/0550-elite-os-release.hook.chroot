#!/bin/sh
# EliteLinux: имя системы (PRETTY_NAME) в os-release (его показывают установщик, разметка дисков,
# «О системе»). NAME, ID и VERSION_ID оставляем — по ним сторонние программы
# (Chrome, Zoom, AnyDesk) определяют, что это Debian.
# dpkg-divert — чтобы обновление base-files не вернуло стандартное имя.
set -e
f=/usr/lib/os-release
dpkg-divert --quiet --local --rename --add --divert "$f.debian" "$f"
sed -e 's/^PRETTY_NAME=.*/PRETTY_NAME="EliteLinux 1.0 (Debian 13)"/' "$f.debian" > "$f"
grep -q '^PRETTY_NAME="EliteLinux' "$f"
