Description: «Другие…» в списке учёток — только если разрешён ручной ввод логина
 lightdm-gtk-greeter 2.0.9 добавляет пункт «Other...» всегда, не глядя на
 greeter-show-manual-login. EliteLinux показывает только «Менеджер» и
 «Администратор».
Author: EliteLinux
--- a/src/lightdm-gtk-greeter.c
+++ b/src/lightdm-gtk-greeter.c
@@ -2768,12 +2768,15 @@
                             -1);
     }
 
-    gtk_list_store_append (GTK_LIST_STORE (model), &iter);
-    gtk_list_store_set (GTK_LIST_STORE (model), &iter,
-                        0, "*other",
-                        1, _("Other..."),
-                        2, PANGO_WEIGHT_NORMAL,
-                        -1);
+    if (lightdm_greeter_get_show_manual_login_hint (greeter))
+    {
+        gtk_list_store_append (GTK_LIST_STORE (model), &iter);
+        gtk_list_store_set (GTK_LIST_STORE (model), &iter,
+                            0, "*other",
+                            1, _("Other..."),
+                            2, PANGO_WEIGHT_NORMAL,
+                            -1);
+    }
 
     last_user = config_get_string (STATE_SECTION_GREETER, STATE_KEY_LAST_USER, NULL);
 
